# Reference material: design PNGs and prose. Images would go through vision
# extraction, which is slow and expensive, and tells us nothing about the code.
docs/

# Static assets: icons, logos, the CV PDF, screenshots. Content, not structure.
static/

# The graph's own output — never feed it back into itself.
graphify-out/

# Lockfile: thousands of lines, zero architectural signal.
bun.lock

